 };
 
+#if PA_CHECK_VERSION(3,99,0)
+#define PULSE_DIRECT_SINK_AAC_CAPS \
+  "audio/mpeg, mpegversion = (int) { 2, 4 }, " \
+    "framed = (boolean) true, stream-format = (string) adts;" \
+    "audio/mpeg, mpegversion = (int) { 2, 4 }, " \
+    "framed = (boolean) true, stream-format = (string) raw;"
+#else
+#define PULSE_DIRECT_SINK_AAC_CAPS ""
+#endif
+
 #define PULSE_DIRECT_SINK_TEMPLATE_CAPS \
   "audio/mpeg, mpegversion = (int) 1, layer = (int) 3, " \
-    "mpegaudioversion = (int) [ 1, 3 ], parsed = (boolean) true;"
+    "mpegaudioversion = (int) [ 1, 3 ], parsed = (boolean) true;" \
+  PULSE_DIRECT_SINK_AAC_CAPS
 
