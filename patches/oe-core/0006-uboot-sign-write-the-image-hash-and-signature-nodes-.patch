+            entry = <${UBOOT_FIT_ARM_TRUSTED_FIRMWARE_ENTRYPOINT}>;
+            compression = "none";
+EOF
+	uboot_fitimage_image_signing
 
 	cat << EOF >> ${UBOOT_ITS}
         };
