From 3cbc67a9931dc38883de32d5911a1267f8d3bdaa Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Fri, 2 Jan 2026 19:53:44 +0100
Subject: [PATCH 32/85] thunderbolt: nhi: Manually clear interrupts for !MSI-X
 if necessary

Commit 468c49f44759 ("thunderbolt: Disable interrupt auto clear for
rings") added the manual clearing required if !QUIRK_AUTO_CLEAR_INT,
however it omitted the legacy/single-MSI case.

Fix that up.

Fixes: 468c49f44759 ("thunderbolt: Disable interrupt auto clear for rings")
Signed-off-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Upstream-Status: Pending
---
 drivers/thunderbolt/nhi.c | 20 +++++++++-----------
 drivers/thunderbolt/pci.c |  2 +-
 2 files changed, 10 insertions(+), 12 deletions(-)

diff --git a/drivers/thunderbolt/nhi.c b/drivers/thunderbolt/nhi.c
index 263bd04d0e7d..cf511865e6c2 100644
--- a/drivers/thunderbolt/nhi.c
+++ b/drivers/thunderbolt/nhi.c
@@ -527,19 +527,13 @@ void tb_ring_poll_complete(struct tb_ring *ring)
 }
 EXPORT_SYMBOL_GPL(tb_ring_poll_complete);
 
-static void ring_clear_msix(const struct tb_ring *ring)
+static void ring_clear_intr(struct tb_nhi *nhi, unsigned int bit)
 {
-	int bit;
-
-	if (ring->nhi->quirks & QUIRK_AUTO_CLEAR_INT)
+	if (nhi->quirks & QUIRK_AUTO_CLEAR_INT)
 		return;
 
-	bit = ring_interrupt_index(ring) & 31;
-	if (ring->is_tx)
-		iowrite32(BIT(bit), ring->nhi->iobase + REG_RING_INT_CLEAR);
-	else
-		iowrite32(BIT(bit), ring->nhi->iobase + REG_RING_INT_CLEAR +
-			  4 * (ring->nhi->hop_count / 32));
+	iowrite32(BIT(bit % 32), nhi->iobase + REG_RING_INT_CLEAR +
+		  sizeof(u32) * (bit / 32));
 }
 
 irqreturn_t ring_msix(int irq, void *data)
@@ -547,7 +541,7 @@ irqreturn_t ring_msix(int irq, void *data)
 	struct tb_ring *ring = data;
 
 	spin_lock(&ring->nhi->lock);
-	ring_clear_msix(ring);
+	ring_clear_intr(ring->nhi, ring_interrupt_index(ring));
 	spin_lock(&ring->lock);
 	__ring_interrupt(ring);
 	spin_unlock(&ring->lock);
@@ -1064,6 +1058,7 @@ irqreturn_t nhi_msi_thread_optimized(int irq, void *data)
 			continue;
 		if (type == 2) {
 			dev_warn(nhi->dev, "RX overflow for ring %d\n", hop);
+			ring_clear_intr(nhi, bit);
 			continue;
 		}
 		if (type == 0)
@@ -1075,9 +1070,12 @@ irqreturn_t nhi_msi_thread_optimized(int irq, void *data)
 				 "got interrupt for inactive %s ring %d\n",
 				 type ? "RX" : "TX",
 				 hop);
+			ring_clear_intr(nhi, bit);
 			continue;
 		}
 
+		ring_clear_intr(nhi, bit);
+
 		spin_lock(&ring->lock);
 		if (ring->start_poll)
 			__ring_interrupt(ring);
diff --git a/drivers/thunderbolt/pci.c b/drivers/thunderbolt/pci.c
index 312b190fb28c..be6e0771704a 100644
--- a/drivers/thunderbolt/pci.c
+++ b/drivers/thunderbolt/pci.c
@@ -204,7 +204,7 @@ static int nhi_pci_init_msi(struct tb_nhi *nhi)
 		if (nvec < 0)
 			return nvec;
 
-		INIT_WORK(&nhi->interrupt_work, nhi_interrupt_work);
+		// INIT_WORK(&nhi->interrupt_work, nhi_interrupt_work);
 
 		irq = pci_irq_vector(pdev, 0);
 		if (irq < 0)
-- 
