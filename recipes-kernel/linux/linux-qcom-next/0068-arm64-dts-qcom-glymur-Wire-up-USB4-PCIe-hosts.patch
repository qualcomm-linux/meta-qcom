+				#size-cells = <2>;
+				ranges;
+			};
+		};
+
+		pcie2: pcie@1c18000 {
+			device_type = "pci";
+			compatible = "qcom,glymur-pcie", "qcom,pcie-x1e80100";
+			reg = <0x0 0x01c18000 0x0 0x3000>,
