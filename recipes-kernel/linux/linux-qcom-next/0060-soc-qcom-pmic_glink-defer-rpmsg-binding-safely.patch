From bb4c9f9c9f083e8fc97e43133ca40b5fd2cb0f36 Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Wed, 2 Sep 2026 18:54:46 +0200
Subject: [PATCH 60/85] soc: qcom: pmic_glink: defer rpmsg binding safely

The PMIC GLINK rpmsg channel may be announced before the platform
device has completed probing. Returning -EPROBE_DEFER from the rpmsg
probe now parks the GLINK endpoint instead of closing the channel, so
normal deferred probing can retry the original endpoint.

Create a persistent device link from the rpmsg consumer to the PMIC
GLINK platform device so platform teardown is ordered after the rpmsg
consumer has stopped using the PMIC GLINK state.

Fixes: 58ef4ece1e41 ("soc: qcom: pmic_glink: Introduce base PMIC GLINK driver")
Upstream-Status: Pending
---
 drivers/soc/qcom/pmic_glink.c | 23 ++++++++++++++++-------
 1 file changed, 16 insertions(+), 7 deletions(-)

diff --git a/drivers/soc/qcom/pmic_glink.c b/drivers/soc/qcom/pmic_glink.c
index 7ee70a31ba15..9813d82854df 100644
--- a/drivers/soc/qcom/pmic_glink.c
+++ b/drivers/soc/qcom/pmic_glink.c
@@ -247,6 +247,7 @@ static void pmic_glink_pdr_callback(int state, char *svc_path, void *priv)
 
 static int pmic_glink_rpmsg_probe(struct rpmsg_device *rpdev)
 {
+	struct device_link *link;
 	struct pmic_glink *pg;
 
 	guard(mutex)(&__pmic_glink_lock);
@@ -254,6 +255,13 @@ static int pmic_glink_rpmsg_probe(struct rpmsg_device *rpdev)
 	if (!pg)
 		return dev_err_probe(&rpdev->dev, -ENODEV, "no pmic_glink device to attach to\n");
 
+	link = device_link_add(&rpdev->dev, pg->dev, DL_FLAG_AUTOPROBE_CONSUMER);
+	if (!link)
+		return -ENOMEM;
+
+	if (READ_ONCE(link->status) == DL_STATE_SUPPLIER_UNBIND)
+		return -EPROBE_DEFER;
+
 	dev_set_drvdata(&rpdev->dev, pg);
 	pg->pdr_available = rpdev->id.driver_data;
 
@@ -268,10 +276,8 @@ static int pmic_glink_rpmsg_probe(struct rpmsg_device *rpdev)
 
 static void pmic_glink_rpmsg_remove(struct rpmsg_device *rpdev)
 {
-	struct pmic_glink *pg;
+	struct pmic_glink *pg = dev_get_drvdata(&rpdev->dev);
 
-	guard(mutex)(&__pmic_glink_lock);
-	pg = __pmic_glink;
 	if (!pg)
 		return;
 
@@ -280,6 +286,7 @@ static void pmic_glink_rpmsg_remove(struct rpmsg_device *rpdev)
 	if (!pg->pdr_available)
 		pg->pdr_state = SERVREG_SERVICE_STATE_DOWN;
 	pmic_glink_state_notify_clients(pg);
+	dev_set_drvdata(&rpdev->dev, NULL);
 }
 
 static const struct rpmsg_device_id pmic_glink_rpmsg_id_match[] = {
@@ -387,6 +394,10 @@ static void pmic_glink_remove(struct platform_device *pdev)
 {
 	struct pmic_glink *pg = dev_get_drvdata(&pdev->dev);
 
+	mutex_lock(&__pmic_glink_lock);
+	__pmic_glink = NULL;
+	mutex_unlock(&__pmic_glink_lock);
+
 	pdr_handle_release(pg->pdr);
 
 	if (pg->data->client_mask & BIT(PMIC_GLINK_CLIENT_BATT))
@@ -398,8 +409,6 @@ static void pmic_glink_remove(struct platform_device *pdev)
 	if (pg->data->client_mask & BIT(PMIC_GLINK_CLIENT_RTC))
 		pmic_glink_del_aux_device(pg, &pg->rtc_aux);
 
-	guard(mutex)(&__pmic_glink_lock);
-	__pmic_glink = NULL;
 }
 
 static const struct pmic_glink_data pmic_glink_glymur_data = {
@@ -440,7 +449,7 @@ static struct platform_driver pmic_glink_driver = {
 	},
 };
 
-static int pmic_glink_init(void)
+static int __init pmic_glink_init(void)
 {
 	int ret;
 
@@ -458,7 +467,7 @@ static int pmic_glink_init(void)
 }
 module_init(pmic_glink_init);
 
-static void pmic_glink_exit(void)
+static void __exit pmic_glink_exit(void)
 {
 	unregister_rpmsg_driver(&pmic_glink_rpmsg_driver);
 	platform_driver_unregister(&pmic_glink_driver);
-- 
