From c5cdaaecdc874326f0e5ea3bba27b862d9b4f8f2 Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Tue, 27 Oct 2026 16:43:30 +0100
Subject: [PATCH 18/85] clk: qcom: gcc-glymur: Set FORCE_MEM_ON for USB4 uC
 clocks

On Glymur and Mahua, the USB4 uC's RAM contents may not be retained
correctly by default. Set the corresponding signals to force it.

Fixes: efe504300a17 ("clk: qcom: gcc: Add support for Global Clock Controller")
Signed-off-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Upstream-Status: Pending
---
 drivers/clk/qcom/gcc-glymur.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/clk/qcom/gcc-glymur.c b/drivers/clk/qcom/gcc-glymur.c
index fe4d8d91cdd7..e6bd15b88be2 100644
--- a/drivers/clk/qcom/gcc-glymur.c
+++ b/drivers/clk/qcom/gcc-glymur.c
@@ -8497,6 +8497,15 @@ static void clk_glymur_regs_configure(struct device *dev, struct regmap *regmap)
 {
 	/* FORCE_MEM_CORE_ON for ufs phy ice core clocks */
 	qcom_branch_set_force_mem_core(regmap, gcc_ufs_phy_ice_core_clk, true);
+
+
+	/*
+	 * FORCE_MEM_CORE_ON for the USB4 uC memory, otherwise it loses its contents when the
+	 * clocks are gated (e.g. across system suspend).
+	 */
+	qcom_branch_set_force_mem_core(regmap, gcc_usb4_0_sys_clk, true);
+	qcom_branch_set_force_mem_core(regmap, gcc_usb4_1_uc_hrr_clk, true);
+	qcom_branch_set_force_mem_core(regmap, gcc_usb4_2_sys_clk, true);
 }
 
 static const struct qcom_cc_driver_data gcc_glymur_driver_data = {
-- 
