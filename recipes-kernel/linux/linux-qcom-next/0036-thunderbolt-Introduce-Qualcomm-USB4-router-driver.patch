+static void qcusb4_cable_plug_work(struct work_struct *work)
+{
+	struct qcom_usb4 *qcusb4 = container_of(work, struct qcom_usb4, cable_plug_work);
+	struct device *dev = qcusb4->nhi.dev;
+	u64 tx_eq_presets;
+	int ret;
+
+	u32 begin_hse_args = 0;
+	bool needs_rpm_put = false;
+
+	guard(mutex)(&qcusb4->typec_lock);
+
+	if (qcusb4->hard_suspended) {
+		/* Tell the resume path to bring the PHY up before waking the FW */
+		WRITE_ONCE(qcusb4->cable_present, true);
+		ret = pm_generic_resume_noirq(dev);
+		if (ret) {
+			WRITE_ONCE(qcusb4->cable_present, false);
+			dev_err(dev, "Couldn't resume the router: %d\n", ret);
+			return;
+		}
+
+		pm_runtime_use_autosuspend(dev);
+		pm_runtime_enable(dev);
+	} else if (!pm_runtime_enabled(dev)) {
+		/*
+		 * A system resume after an unplug has already brought the router back up,
+		 * but runtime PM is still disabled from the unplug
+		 */
+		pm_runtime_use_autosuspend(dev);
+		pm_runtime_enable(dev);
+	} else {
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret) {
+			dev_err(dev, "Couldn't enable the host router: %d\n", ret);
+			return;
+		}
+
+		needs_rpm_put = true;
+	}
+
+	/* The router itself is brought up in probe */
+	if (!qcusb4->phy_prepared) {
+		ret = qcusb4_prepare_phy(qcusb4);
+		if (ret) {
+			dev_err(dev, "Failed to prepare the USB4 PHY: %d\n", ret);
+			goto out_rpm_put;
+		}
+	}
+
+	qcusb4->cable_present = true;
+
+	/* Choose which PHY presets to offer during link establishment */
+	if (device_property_read_u64(dev, "tx-equalization-presets", &tx_eq_presets))
+		tx_eq_presets =  BIT(0) | BIT(1) | BIT(5) | BIT(6) | BIT(10) | BIT(11);
+
+	usb4_qcom_send_fw_cmd(qcusb4, FW_CMD_ENABLE_PHY_PRESETS,
+			      FIELD_GET(GENMASK(23, 0), tx_eq_presets));
+
+	if (is_usb4v2(qcusb4))
+		usb4_qcom_send_fw_cmd(qcusb4, FW_CMD_ENABLE_PHY_PRESETS_MSB,
+				      FIELD_GET(GENMASK(41, 24), tx_eq_presets));
+
+	if (qcusb4->cable_phy_submode == PHY_SUBMODE_USB4)
+		begin_hse_args |= BIT(0);
+
+	if (qcusb4->orientation == TYPEC_ORIENTATION_REVERSE)
+		begin_hse_args |= BIT(1);
+
+	/* TODO: do not set this bit if an onboard retimer (such as PS883x) is absent */
+	begin_hse_args |= BIT(2);
+
+	if (qcusb4->active_cable)
+		begin_hse_args |= BIT(3);
+
+	if (qcusb4->cable_legacy_tbt3)
+		begin_hse_args |= BIT(4);
+
+	if (qcusb4->cable_has_gen3)
+		begin_hse_args |= BIT(5);
+
+	usb4_qcom_send_fw_cmd(qcusb4, FW_CMD_BEGIN_HSE, begin_hse_args);
+
+out_rpm_put:
+	if (needs_rpm_put) {
+		ret = pm_runtime_put_autosuspend(dev);
+		if (ret)
+			dev_err(dev, "finalizing pm_runtime_put failed: %d\n", ret);
+	}
+}
