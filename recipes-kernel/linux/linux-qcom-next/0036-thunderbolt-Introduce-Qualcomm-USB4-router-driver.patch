+static void qcusb4_clks_disable(struct qcom_usb4 *qcusb4)
+{
+	clk_disable_unprepare(qcusb4->hrr_clk);
+	clk_bulk_disable_unprepare(NUM_CLKS, qcusb4->clks);
+}
