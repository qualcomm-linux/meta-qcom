+static int qcusb4_clks_enable(struct qcom_usb4 *qcusb4)
+{
+	int ret;
+
+	ret = clk_bulk_prepare_enable(NUM_CLKS, qcusb4->clks);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(qcusb4->hrr_clk);
+	if (ret)
+		clk_bulk_disable_unprepare(NUM_CLKS, qcusb4->clks);
+
+	return ret;
+}
