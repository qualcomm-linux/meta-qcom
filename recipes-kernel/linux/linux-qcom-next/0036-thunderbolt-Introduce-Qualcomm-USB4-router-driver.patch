+	.drom_tid = 0x34eb,
+};
+
+static const struct of_device_id qcom_usb4_of_match_table[] = {
+	{ .compatible = "qcom,x1e80100-usb4-hr", .data = &x1e80100_data },
+	{ .compatible = "qcom,glymur-usb4-hr", .data = &glymur_data },
