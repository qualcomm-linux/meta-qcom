diff --git a/drivers/thunderbolt/qcom.c b/drivers/thunderbolt/qcom.c
new file mode 100644
index 000000000000..feab5c023022
--- /dev/null
+++ b/drivers/thunderbolt/qcom.c
@@ -0,0 +1,2012 @@
+// SPDX-License-Identifier: GPL-2.0-only
