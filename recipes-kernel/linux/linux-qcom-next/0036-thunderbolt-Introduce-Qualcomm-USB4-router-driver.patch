+static irqreturn_t qcom_usb4_pcie_ap_irq_handler(int irq, void *data)
+{
+	struct qcom_usb4 *qcusb4 = data;
+	u32 val;
+
+	val = readl(qcusb4->pcie_cfg + PCIEAP_CONFIG_IRQ_STATUS);
+	writel(val, qcusb4->pcie_cfg + PCIEAP_CONFIG_IRQ_CLEAR);
+
+	return IRQ_HANDLED;
+}
