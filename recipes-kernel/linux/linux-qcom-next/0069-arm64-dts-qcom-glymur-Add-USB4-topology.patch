From 18a61c1dae432ff0a1bece806f987dddeb03b369 Mon Sep 17 00:00:00 2001
From: Wesley Cheng <wesley.cheng@oss.qualcomm.com>
Date: Thu, 1 Oct 2026 17:52:22 +0200
Subject: [PATCH 69/85] arm64: dts: qcom: glymur: Add USB4 topology

Describe the USB4 PHY clocks, router, Type-C endpoints, PCIe tunnel
host interface, and tunneled DisplayPort resources on Glymur and the CRD.

[konrad: fixes]

Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/glymur-crd.dtsi |  29 +-
 arch/arm64/boot/dts/qcom/glymur.dtsi     | 722 ++++++++++++++++++++++-
 2 files changed, 739 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-crd.dtsi b/arch/arm64/boot/dts/qcom/glymur-crd.dtsi
index 5b2078cc8716..850a04491da8 100644
--- a/arch/arm64/boot/dts/qcom/glymur-crd.dtsi
+++ b/arch/arm64/boot/dts/qcom/glymur-crd.dtsi
@@ -96,13 +96,22 @@ pmic_glink_hs_in: endpoint {
 					};
 				};
 
-				port@1 {
-					reg = <1>;
+				port@2 {
+					reg = <2>;
 
 					pmic_glink_ss_in: endpoint {
 						remote-endpoint = <&usb_0_qmpphy_out>;
 					};
 				};
+
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_usb4_in: endpoint {
+						remote-endpoint = <&usb4_0_mode_in>;
+					};
+				};
 			};
 		};
 
@@ -131,6 +140,14 @@ pmic_glink_ss_in1: endpoint {
 						remote-endpoint = <&usb_1_qmpphy_out>;
 					};
 				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_usb4_in1: endpoint {
+						remote-endpoint = <&usb4_1_mode_in>;
+					};
+				};
 			};
 		};
 	};
@@ -1684,6 +1701,14 @@ bluetooth {
 	};
 };
 
+&usb4_0_mode_in {
+	remote-endpoint = <&pmic_glink_usb4_in>;
+};
+
+&usb4_1_mode_in {
+	remote-endpoint = <&pmic_glink_usb4_in1>;
+};
+
 &usb_0 {
 	status = "okay";
 };
