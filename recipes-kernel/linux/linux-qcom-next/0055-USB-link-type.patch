From b8ffaa80a538decef9ea89106933faf6d8d45d29 Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Date: Wed, 15 Jul 2026 14:19:26 +0200
Subject: [PATCH 55/85] USB link type

Upstream-Status: Pending
---
 drivers/usb/host/xhci.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/host/xhci.c b/drivers/usb/host/xhci.c
index 349fb16a686f..36341be5201a 100644
--- a/drivers/usb/host/xhci.c
+++ b/drivers/usb/host/xhci.c
@@ -4769,11 +4769,11 @@ int xhci_update_device(struct usb_hcd *hcd, struct usb_device *udev)
 		}
 
 		if (udev->tunnel_mode == USB_LINK_UNKNOWN)
-			dev_dbg(&udev->dev, "link tunnel state unknown\n");
+			dev_err(&udev->dev, "link tunnel state unknown\n");
 		else if (udev->tunnel_mode == USB_LINK_TUNNELED)
-			dev_dbg(&udev->dev, "tunneled over USB4 link\n");
+			dev_err(&udev->dev, "tunneled over USB4 link\n");
 		else if (udev->tunnel_mode == USB_LINK_NATIVE)
-			dev_dbg(&udev->dev, "native USB 3.x link\n");
+			dev_err(&udev->dev, "native USB 3.x link\n");
 		return 0;
 	}
 
