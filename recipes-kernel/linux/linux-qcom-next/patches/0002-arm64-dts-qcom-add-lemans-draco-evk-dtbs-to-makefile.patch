From 9641e5a42258e0940696524f8f7ee38c5780dafb Mon Sep 17 00:00:00 2001
From: Gopikishan Thawre <gthawre@qti.qualcomm.com>
Date: Thu, 10 Sep 2026 14:44:36 +0530
Subject: [PATCH 2/4] arm64: dts: qcom: Add lemans-draco-evk DTBs to Makefile

Add build entries for lemans-draco-evk.dtb and
lemans-draco-evk-el2.dtb.

Upstream-Status: Pending
Signed-off-by: Gopikishan Thawre <gthawre@qti.qualcomm.com>
---
 arch/arm64/boot/dts/qcom/Makefile | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1c86e7e98f55..b5dd54fda7a3 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -51,6 +51,11 @@ dtb-$(CONFIG_ARCH_QCOM)	+= kaanapali-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= kaanapali-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= kalambo-crd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= lemans-evk.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= lemans-draco-evk.dtb
+
+lemans-draco-evk-el2-dtbs := lemans-draco-evk.dtb lemans-el2.dtbo
+
+dtb-$(CONFIG_ARCH_QCOM)	+= lemans-draco-evk-el2.dtb
 
 lemans-evk-emmc-dtbs := lemans-evk.dtb lemans-evk-emmc.dtbo
 dtb-$(CONFIG_ARCH_QCOM) += lemans-evk-emmc.dtb
