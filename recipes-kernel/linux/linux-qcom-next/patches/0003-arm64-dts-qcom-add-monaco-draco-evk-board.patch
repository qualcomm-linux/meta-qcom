From 0931ac674c4d369f094b4a3b98729dcf6c5832ee Mon Sep 17 00:00:00 2001
From: Faruque Ansari <faruque.ansari@oss.qualcomm.com>
Date: Thu, 8 Oct 2026 18:23:59 +0530
Subject: [PATCH 3/3] arm64: dts: qcom: add monaco draco evk board

Add the board device tree for the Monaco Draco EVK, combining the
Monaco Draco EVK SOM and the AC carrier board. The board-specific
peripherals are the carrier board I2C GPIO expanders: four
tca6416-compatible (kts1622) expanders on i2c14 and two tca9538
expanders on i2c15. Also wire up the board dtb and its monaco-el2
overlay variant in the Makefile.

Signed-off-by: Faruque Ansari <faruque.ansari@oss.qualcomm.com>
Upstream-Status: Pending
---
 arch/arm64/boot/dts/qcom/Makefile             |  5 ++
 .../boot/dts/qcom/monaco-draco-evk.dts     | 65 +++++++++++++++++++
 2 files changed, 70 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/monaco-draco-evk.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 1c86e7e98f55..dbeaefa162d2 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -87,6 +87,11 @@ dtb-$(CONFIG_ARCH_QCOM)	+= milos-fairphone-fp6.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= milos-nothing-asteroids.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= monaco-arduino-monza.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= monaco-ac-evk.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= monaco-draco-evk.dtb
+
+monaco-draco-evk-el2-dtbs := monaco-draco-evk.dtb monaco-el2.dtbo
+dtb-$(CONFIG_ARCH_QCOM)	+= monaco-draco-evk-el2.dtb
+
 dtb-$(CONFIG_ARCH_QCOM)	+= monaco-evk.dtb

 monaco-evk-camera-imx577-dtbs	:= monaco-evk.dtb monaco-evk-camera-imx577.dtbo
diff --git a/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
new file mode 100644
index 000000000000..3b3e9ebeee67
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/monaco-draco-evk.dts
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+/dts-v1/;
+
+#include "monaco-draco-ac-evk-som.dtsi"
+
+/ {
+	model = "Qualcomm Technologies, Inc. Monaco Draco EVK";
+	compatible = "qcom,monaco-draco-evk", "qcom,qcs8300";
+	chassis-type = "embedded";
+};
+
+&i2c14 {
+	status = "okay";
+
+	expander0: gpio@20 {
+		compatible = "kinetic,kts1622", "ti,tcal6416";
+		reg = <0x20>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+
+	expander1: gpio@21 {
+		compatible = "kinetic,kts1622", "ti,tcal6416";
+		reg = <0x21>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+
+	expander2: gpio@22 {
+		compatible = "kinetic,kts1622", "ti,tcal6416";
+		reg = <0x22>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+
+	expander3: gpio@23 {
+		compatible = "kinetic,kts1622", "ti,tcal6416";
+		reg = <0x23>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+
+};
+
+&i2c15 {
+	status = "okay";
+
+	expander4: gpio@38 {
+		compatible = "ti,tca9538";
+		reg = <0x38>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+
+	expander5: gpio@3c {
+		compatible = "ti,tca9538";
+		reg = <0x3c>;
+		#gpio-cells = <2>;
+		gpio-controller;
+	};
+};
--
2.34.1

