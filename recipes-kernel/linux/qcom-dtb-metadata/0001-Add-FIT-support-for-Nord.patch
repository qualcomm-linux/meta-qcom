From a420f565982d1196db615cabdc690b4c9fd7a504 Mon Sep 17 00:00:00 2001
From: Viswanath Kraleti <viswanath.kraleti@oss.qualcomm.com>
Date: Mon, 7 Sep 2026 12:05:18 +0530
Subject: [PATCH] Add FIT support for Nord boards

 * In qcom-metadata.dts add msm-ids for Nord(0x288) and qam8x97p(0x2b2)
 * In qcom-next-fitimage.its add conf-73 for qcom,qam8x97p-qam and
   conf-74 for qcom,nord-qam

Signed-off-by: Viswanath Kraleti <viswanath.kraleti@oss.qualcomm.com>
Upstream-Status: Submitted [https://github.com/qualcomm-linux/qcom-dtb-metadata/pull/140]
---
 qcom-metadata.dts      |  8 ++++++++
 qcom-next-fitimage.its | 16 ++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/qcom-metadata.dts b/qcom-metadata.dts
index 333464a..87a9727 100644
--- a/qcom-metadata.dts
+++ b/qcom-metadata.dts
@@ -28,10 +28,18 @@
 			msm-id = <0x000002b5>;
 		};
 
+		nord {
+			msm-id = <0x00000288>;
+		};
+
 		purwa {
 			msm-id = <0x000002c7>;
 		};
 
+		qam8x97p {
+			msm-id = <0x000002b2>;
+		};
+
 		qcm6490 {
 			msm-id = <0x000001f1>;
 		};
diff --git a/qcom-next-fitimage.its b/qcom-next-fitimage.its
index 9da5371..e098825 100644
--- a/qcom-next-fitimage.its
+++ b/qcom-next-fitimage.its
@@ -250,6 +250,14 @@
 			data = /incbin/("./arch/arm64/boot/dts/qcom/mahua-crd.dtb");
 			type = "flat_dt";
 		};
+		fdt-nord-ride-embedded.dtb {
+			data =
+			/incbin/("./arch/arm64/boot/dts/qcom/nord-ride-embedded.dtb");
+			type = "flat_dt";
+		fdt-nord-rrd.dtb {
+			data = /incbin/("./arch/arm64/boot/dts/qcom/nord-rrd.dtb");
+			type = "flat_dt";
+		};
 		fdt-purwa-staging.dtbo {
 			data = /incbin/("./arch/arm64/boot/dts/qcom/purwa-staging.dtbo");
 			type = "flat_dt";
@@ -541,5 +549,13 @@
 			compatible = "qcom,purwa-evk-el2kvm-staging";
 			fdt = "fdt-purwa-iot-evk.dtb", "fdt-x1-el2.dtbo", "fdt-purwa-staging.dtbo";
 		};
+		conf-73 {
+			compatible = "qcom,qam8x97p-qam";
+			fdt = "fdt-nord-ride-embedded.dtb";
+		};
+		conf-74 {
+			compatible = "qcom,nord-qam";
+			fdt = "fdt-nord-rrd.dtb";
+		};
 	};
 };
