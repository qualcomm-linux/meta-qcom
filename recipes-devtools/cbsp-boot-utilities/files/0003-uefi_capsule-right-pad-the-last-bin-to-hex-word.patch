From c12c05dfc28f883a2b97a3262608ffb3afe73a73 Mon Sep 17 00:00:00 2001
From: Renan Prata <renancprata@gmail.com>
Date: Mon, 19 Oct 2026 09:17:09 -0300
Subject: [PATCH] uefi_capsule: right-pad the last bin-to-hex word

bin_to_hex() writes a 32-bit length header followed by the data as
32-bit words. A short last chunk was padded with zfill(8), which puts
the zeros in front of the data, so for a file whose length is not a
multiple of 4 the reader (patch-capsule-cert @list:, qdte-lite) keeps
`length` bytes and loses the last 1-3 bytes of the certificate.

Pad the last chunk after the data instead, and add a round-trip test
for lengths 928-931 (it fails on main for 929-931).

Found on a QCM6490 board (Quectel SG560D, QLI 1.6): the
QcCapsuleRootCert in its xbl_config.elf is a 999-byte certificate
whose last byte is missing. The lost bytes fall in the root's own
signature, which OpenSSL does not check for a trust anchor, so
capsules still verified.

Upstream-Status: Submitted [https://github.com/qualcomm/cbsp-boot-utilities/pull/56]

Signed-off-by: Renan Prata <renancprata@gmail.com>
---
 .../src/qcom_capsule_tool/BinToHex.py         |  8 +++---
 .../tests/test_bin_to_hex.py                  | 26 +++++++++++++++++++
 2 files changed, 30 insertions(+), 4 deletions(-)
 create mode 100644 uefi_capsule_generation/tests/test_bin_to_hex.py

diff --git a/uefi_capsule_generation/src/qcom_capsule_tool/BinToHex.py b/uefi_capsule_generation/src/qcom_capsule_tool/BinToHex.py
index 5bdd2db..b00c94a 100644
--- a/uefi_capsule_generation/src/qcom_capsule_tool/BinToHex.py
+++ b/uefi_capsule_generation/src/qcom_capsule_tool/BinToHex.py
@@ -20,10 +20,10 @@ def bin_to_hex(input_file, output_file):
 
     hex_chunks = [header]
     for i in range(0, len(binary_data), 4):
-        chunk = binary_data[i : i + 4]
-        hex_chunk = "".join(f"{byte:02x}" for byte in chunk)
-        # Ensure each chunk is 8 hex digits.
-        hex_chunks.append(hex_chunk.zfill(8))
+        # Pad a short last chunk with zeros after the data: the header
+        # holds the real length, so the reader keeps only the first bytes.
+        chunk = binary_data[i : i + 4].ljust(4, b"\x00")
+        hex_chunks.append(chunk.hex())
 
     try:
         with open(output_file, "w") as f:
diff --git a/uefi_capsule_generation/tests/test_bin_to_hex.py b/uefi_capsule_generation/tests/test_bin_to_hex.py
new file mode 100644
index 0000000..3c0c102
--- /dev/null
+++ b/uefi_capsule_generation/tests/test_bin_to_hex.py
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+"""bin-to-hex output, as read back by patch-capsule-cert (@list:)."""
+
+import struct
+
+import pytest
+
+from qcom_capsule_tool.BinToHex import bin_to_hex
+from qcom_capsule_tool.patch_capsule_cert import _encode_dtb_value
+
+
+@pytest.mark.parametrize("size", [928, 929, 930, 931])
+def test_round_trip_keeps_every_byte(tmp_path, size):
+    data = bytes((i * 7 + 3) % 256 for i in range(size))
+    src = tmp_path / "cert.cer"
+    inc = tmp_path / "cert.inc"
+    src.write_bytes(data)
+
+    bin_to_hex(str(src), str(inc))
+    value = _encode_dtb_value(f"@list:{inc}")
+
+    (length,) = struct.unpack(">I", value[:4])
+    assert length == size
+    assert value[4 : 4 + length] == data
+    assert len(value) % 4 == 0
