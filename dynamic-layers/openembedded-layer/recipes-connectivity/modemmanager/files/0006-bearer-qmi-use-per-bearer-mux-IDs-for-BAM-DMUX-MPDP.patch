From 2b37db911979174b8a1b7767a9ce48c6d8a7612a Mon Sep 17 00:00:00 2001
From: Harsh Sharma <hsharm@qti.qualcomm.com>
Date: Mon, 26 Oct 2026 03:32:06 -0700
Subject: [PATCH 6/9] bearer-qmi: use per-bearer mux IDs for BAM-DMUX MPDP
 support

BAM-DMUX single-PDN operation binds all WDS clients to mux-id 0.
For multi-PDN support, each bearer must use its assigned mux-id so
multiple simultaneous data sessions can coexist on the same data path.

Use the bearer mux-id when available and fall back to the default
single-PDN behavior when no mux-id has been allocated.

Upstream-Status: Submitted [https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/merge_requests/1452]
Signed-off-by: Harsh Sharma <hsharm@qti.qualcomm.com>
---
 src/mm-bearer-qmi.c | 26 ++++++++++++++++++++------
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/mm-bearer-qmi.c b/src/mm-bearer-qmi.c
index 0cee9f72..00bfea16 100644
--- a/src/mm-bearer-qmi.c
+++ b/src/mm-bearer-qmi.c
@@ -2066,13 +2066,18 @@ connect_context_step (GTask *task)
     } /* fall through */
 
     case CONNECT_STEP_BIND_DATA_PORT_IPV4:
-        /* BAM-DMUX: BindMuxDataPort with BAM_DMUX type, ep-id=0, mux-id=0 */
+        /* BAM-DMUX: BindMuxDataPort with BAM_DMUX type, ep-id=0.
+         * Use real per-bearer mux_id for MPDP; fall back to 0 for SPDP
+         * (when kernel QMAP support is absent and mux_id is unbound). */
         if (g_strcmp0 (mm_port_qmi_get_net_driver (ctx->qmi), "bam-dmux") == 0) {
             g_autoptr(QmiMessageWdsBindMuxDataPortInput) bam_input = NULL;
             bam_input = qmi_message_wds_bind_mux_data_port_input_new ();
             qmi_message_wds_bind_mux_data_port_input_set_endpoint_info (
                 bam_input, QMI_DATA_ENDPOINT_TYPE_BAM_DMUX, 0, NULL);
-            qmi_message_wds_bind_mux_data_port_input_set_mux_id (bam_input, 0, NULL);
+            qmi_message_wds_bind_mux_data_port_input_set_mux_id (
+                bam_input,
+                ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND ? ctx->mux_id : 1,
+                NULL);
             qmi_client_wds_bind_mux_data_port (ctx->client_ipv4,
                                                bam_input, 10,
                                                g_task_get_cancellable (task),
@@ -2226,13 +2231,18 @@ connect_context_step (GTask *task)
     } /* fall through */
 
     case CONNECT_STEP_BIND_DATA_PORT_IPV6:
-        /* BAM-DMUX: BindMuxDataPort with BAM_DMUX type, ep-id=0, mux-id=0 */
+        /* BAM-DMUX: BindMuxDataPort with BAM_DMUX type, ep-id=0.
+         * Use real per-bearer mux_id for MPDP; fall back to 0 for SPDP
+         * (when kernel QMAP support is absent and mux_id is unbound). */
         if (g_strcmp0 (mm_port_qmi_get_net_driver (ctx->qmi), "bam-dmux") == 0) {
             g_autoptr(QmiMessageWdsBindMuxDataPortInput) bam_input = NULL;
             bam_input = qmi_message_wds_bind_mux_data_port_input_new ();
             qmi_message_wds_bind_mux_data_port_input_set_endpoint_info (
                 bam_input, QMI_DATA_ENDPOINT_TYPE_BAM_DMUX, 0, NULL);
-            qmi_message_wds_bind_mux_data_port_input_set_mux_id (bam_input, 0, NULL);
+            qmi_message_wds_bind_mux_data_port_input_set_mux_id (
+                bam_input,
+                ctx->mux_id != QMI_DEVICE_MUX_ID_UNBOUND ? ctx->mux_id : 1,
+                NULL);
             qmi_client_wds_bind_mux_data_port (ctx->client_ipv6,
                                                bam_input, 10,
                                                g_task_get_cancellable (task),
2.34.1

