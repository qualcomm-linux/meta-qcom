 ########################################
 ## <summary>
 ##	Allow read/ioctl/open for Qualcomm FastRPC secure devices.
@@ -6297,3 +6315,21 @@ interface(`dev_read_secure_fastrpc',`
 
 	read_chr_files_pattern($1, device_t, fastrpc_secure_device_t)
 ')
+
+########################################
+## <summary>
+##	Allow read/write/ioctl/open for Qualcomm FastRPC secure devices.
+## </summary>
+## <param name="domain">
+##	<summary>
+##	Domain allowed access.
+##	</summary>
+## </param>
+#
+interface(`dev_rw_secure_fastrpc',`
+	gen_require(`
+		type device_t, fastrpc_secure_device_t;
+	')
+
+	rw_chr_files_pattern($1, device_t, fastrpc_secure_device_t)
+')
